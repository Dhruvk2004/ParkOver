rules_version = '2';

// ParkOver Firestore rules. Paste into Firebase console → Firestore → Rules → Publish.
// Tested with the emulator: cd firestore-tests && npm test
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isActive(status) { return status in ['PENDING', 'CONFIRMED', 'ACTIVE']; }
    function docPath(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }

    // 30-minute lock buckets, matching BookingRepository.LOCK_BUCKET_MS. Integer division in
    // rules already rounds down for positive times (math.floor would turn it into a float).
    function bucketOf(ts) { return ts.toMillis() / 1800000; }
    // Last bucket an interval touches: the one holding the millisecond before exit.
    function lastBucketOf(exitTs) { return (exitTs.toMillis() - 1) / 1800000; }
    function lockPath(parkingId, spotNumber, bucket) {
      return docPath('slot_locks', parkingId + '_' + spotNumber + '_' + string(bucket));
    }
    // The bay is locked by this booking (checked for the first and last bucket of the stay).
    function lockedBy(b, bookingId, bucket) {
      return getAfter(lockPath(b.parkingId, b.spotNumber, bucket)).data.bookingId == bookingId;
    }

    // Operators run one parking place each. ParkOver writes operators/{uid} by hand in the
    // console; nobody can make themselves an operator from the app.
    function operatorPath() { return docPath('operators', request.auth.uid); }
    function isOperatorOf(parkingId) {
      return signedIn() && exists(operatorPath()) && get(operatorPath()).data.parkingId == parkingId;
    }
    // A time the phone stamped, within 10 minutes of the server's clock.
    function isNow(ts) {
      return ts is timestamp && ts > request.time - duration.value(10, 'm') && ts < request.time + duration.value(10, 'm');
    }

    match /operators/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Profile, saved parkings and UPI IDs: only the owner.
    match /users/{uid} {
      allow read, write: if isUser(uid);
      match /{sub=**} {
        allow read, write: if isUser(uid);
      }
    }

    // Vehicles are top-level documents tagged with userId.
    match /vehicles/{vehicleId} {
      allow read, update, delete: if isUser(resource.data.userId);
      allow create: if isUser(request.resource.data.userId);
    }

    // Bookings are private to their owner and the operator of that parking place.
    // Which bays are taken is public via slot_locks.
    match /bookings/{bookingId} {
      allow read: if isUser(resource.data.userId) || isOperatorOf(resource.data.parkingId);

      // A new booking must be active and hold the slot lock for its first and last bucket,
      // written in the same transaction, so a client can't skip the double-booking check.
      allow create: if isUser(request.resource.data.userId)
                    && request.resource.data.id == bookingId
                    && isActive(request.resource.data.bookingStatus)
                    && request.resource.data.exitTime > request.resource.data.entryTime
                    && lockedBy(request.resource.data, bookingId, bucketOf(request.resource.data.entryTime))
                    && lockedBy(request.resource.data, bookingId, lastBucketOf(request.resource.data.exitTime));

      // Owner can change an active booking (cancel, extend) but not move it, reopen it, or
      // check themselves in or out: only the operator moves a booking past "Booked".
      allow update: if isUser(resource.data.userId)
                    && isActive(resource.data.bookingStatus)
                    && request.resource.data.bookingStatus in [resource.data.bookingStatus, 'CANCELLED']
                    && request.resource.data.diff(resource.data).unchangedKeys().hasAll(
                         ['id', 'userId', 'parkingId', 'spotNumber', 'floorNumber', 'vehicleType', 'entryTime', 'createdAt'])
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['checkedInAt', 'actualExitTime', 'extraCharges', 'walkIn'])
                    && request.resource.data.exitTime >= resource.data.exitTime
                    // Extending must lock the new end of the stay in the same write.
                    && (request.resource.data.exitTime == resource.data.exitTime
                        || lockedBy(request.resource.data, bookingId, lastBucketOf(request.resource.data.exitTime)));

      // The operator of the parking place checks cars in and out.
      allow update: if isOperatorOf(resource.data.parkingId)
                    && (operatorCheckIn(resource.data, request.resource.data)
                        || operatorCheckOut(resource.data, request.resource.data));

      allow delete: if false;
    }

    // Booked → Arrived.
    function operatorCheckIn(before, after) {
      return before.bookingStatus in ['PENDING', 'CONFIRMED']
          && after.bookingStatus == 'ACTIVE'
          && after.diff(before).affectedKeys().hasOnly(['bookingStatus', 'checkedInAt', 'updatedAt'])
          && isNow(after.checkedInAt);
    }

    // Arrived → Exited, with any overstay charge.
    function operatorCheckOut(before, after) {
      return before.bookingStatus == 'ACTIVE'
          && after.bookingStatus == 'COMPLETED'
          && after.diff(before).affectedKeys().hasOnly(['bookingStatus', 'actualExitTime', 'extraCharges', 'updatedAt'])
          && isNow(after.actualExitTime)
          && after.extraCharges is number && after.extraCharges >= 0;
    }

    // One document per bay per 30-minute bucket. Its existence means "taken".
    // Readable by signed-in users (no personal details beyond an opaque user id).
    match /slot_locks/{lockId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.userId)
                    && request.resource.data.keys().hasOnly(['parkingId', 'spotNumber', 'bucket', 'bookingId', 'userId', 'expiresAt'])
                    && request.resource.data.bucket is int
                    && lockId == request.resource.data.parkingId + '_' + request.resource.data.spotNumber + '_'
                                 + string(request.resource.data.bucket);
      // The owner frees their own bay; the operator frees the rest of a stay at check-out.
      allow delete: if isUser(resource.data.userId)
                    || (isOperatorOf(resource.data.parkingId)
                        && getAfter(docPath('bookings', resource.data.bookingId)).data.bookingStatus == 'COMPLETED');
      allow update: if false;
    }

    // Legacy single counters (one number per parking, not time-aware). Read-only now; occupancy
    // below replaced them.
    match /parking_availability/{parkingId} {
      allow read: if true;
      allow write: if false;
    }

    // How many bays are booked per parking, per 30-minute slot: occupancy/{parkingId}_{bucket}
    // with a count per vehicle type (TWO_WHEELER, FOUR_WHEELER, HEAVY) and per floor.
    // "Free now" = capacity - this half-hour's counts, so future bookings don't change today.
    // Public read (shown before sign-in; no personal data).
    match /occupancy/{docId} {
      allow read: if true;
      allow create, update: if signedIn() && validOccupancyChange(docId);
      allow delete: if false;
    }

    // A slot's count moves by exactly +1 (booking created, or extended into this slot) or -1
    // (booking cancelled), for that booking's own type and floor, only inside its stay, never < 0.
    function validOccupancyChange(docId) {
      let d = request.resource.data;
      let ref = docPath('bookings', d.lastBookingId);
      let after = getAfter(ref).data;
      let existed = exists(ref);
      return (after.userId == request.auth.uid || isOperatorOf(after.parkingId))
          && d.parkingId == after.parkingId
          && d.bucket is int
          && docId == after.parkingId + '_' + string(d.bucket)
          && validSlotChange(d, resource == null ? {} : resource.data, after, existed ? get(ref).data : after, existed);
    }

    // (Split from validOccupancyChange: rules allow at most 10 variables per function.)
    // A check-out gives back the slots after the one the car left in.
    function validSlotChange(d, old, after, before, existed) {
      let created = !existed && isActive(after.bookingStatus);
      let cancelled = existed && isActive(before.bookingStatus) && after.bookingStatus == 'CANCELLED';
      let checkedOut = existed && before.bookingStatus == 'ACTIVE' && after.bookingStatus == 'COMPLETED';
      let extended = existed && isActive(before.bookingStatus) && isActive(after.bookingStatus)
                     && after.exitTime > before.exitTime;
      let freed = cancelled || checkedOut;
      let delta = freed ? -1 : 1;
      let first = extended ? lastBucketOf(before.exitTime) + 1
                  : (checkedOut ? bucketOf(after.actualExitTime) + 1 : bucketOf(after.entryTime));
      let last = freed ? lastBucketOf(before.exitTime) : lastBucketOf(after.exitTime);
      let type = after.vehicleType;
      return (created || freed || extended)
          && d.bucket >= first && d.bucket <= last
          && d.diff(old).affectedKeys().hasOnly([type, 'floors', 'lastBookingId', 'lastUpdated', 'parkingId', 'bucket'])
          && d.get(type, 0) == old.get(type, 0) + delta
          && d.get(type, 0) >= 0
          && validFloorDelta(old.get('floors', {}), d.get('floors', {}), string(after.floorNumber), delta);
    }

    function validFloorDelta(before, now, key, delta) {
      return now.diff(before).affectedKeys().hasOnly([key])
          && now.get(key, 0) == before.get(key, 0) + delta
          && now.get(key, 0) >= 0;
    }

    // Support requests: users can file one, nobody can read them back from the app.
    match /support_tickets/{ticketId} {
      allow create: if isUser(request.resource.data.userId);
      allow read, update, delete: if false;
    }
  }
}
